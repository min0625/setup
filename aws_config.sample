# Put the following content in ~/.aws/config
# Replace placeholders with real values before using.
# Create an SSO session with: aws configure sso-session
# Renew the session with: aws sso login
# For AWS CLI v2 SSO, use [sso-session <name>] plus sso_session in profiles.

[default]
sso_session = your-sso-name
region = ap-northeast-1
output = json

[sso-session your-sso-name]
sso_region = ap-northeast-1
sso_start_url = https://<your-domain>.awsapps.com/start
sso_registration_scopes = sso:account:access
# sso_registration_scopes can usually remain as shown for default access.

[profile your-profile-1]
sso_session = your-sso-name
sso_account_id = <123456789012>
sso_role_name = PowerUserAccess
# If you want a read-only profile, uncomment the next line and replace the above role.
# sso_role_name = ViewOnlyAccess
region = ap-northeast-1

[profile your-profile-2]
source_profile = your-profile-1
role_arn = arn:aws:iam::<123456789012>:role/xxx-xxx-xxx
region = ap-northeast-1
# Use source_profile when the role is assumed from another profile's credentials.
